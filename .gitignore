# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock should be committed for reproducible builds
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Coverage
lcov.info
*.profraw
*.profdata

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store


# Locally installed pinned rs-infra tools
.infra/tools/bin/

# Generated infrastructure reports and Pages output
/ci-summary.json
/coverage-badge.json
/coverage-summary.md
/coverage.json
/coverage.txt
/lcov.info
/public/
/pages-artifact.tar.gz
